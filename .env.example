# Copy this file to .env.local and fill in the values.
# In production, set the same variables in Vercel → Settings → Environment Variables.

# RankPill webhook HMAC secret (RankPill dashboard → Webhook → Secret Key).
RANKPILL_WEBHOOK_SECRET=

# NeonDB (serverless Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Cloudflare R2 object storage
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://your-cdn-domain.com

# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=CBN Export Journal <newsletter@cakrabajaniaga.com>

# Email address to notify when a new article is published
NOTIFICATION_EMAIL=

# Site URL (used for email links)
NEXT_PUBLIC_SITE_URL=https://cakrabajaniaga.com
